# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# development | test | production
ENVIRONMENT=development

# PostgreSQL local (desarrollo). Formato:
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/squadfinder

# En producción (Neon) se agrega ?sslmode=require al final, por ejemplo:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/squadfinder?sslmode=require

# auth0 = valida el JWT de Auth0 (obligatorio en producción)
# dev   = solo para programar sin Auth0: el usuario se indica con el encabezado X-Dev-User
AUTH_MODE=dev
AUTH0_DOMAIN=squadfinder-lfg.us.auth0.com
AUTH0_AUDIENCE=https://api.squadfinder-lfg

# Páginas que pueden llamar a la API (lista en formato JSON)
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
