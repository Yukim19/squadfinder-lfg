# En desarrollo este servicio también lee backend/api-service/.env, así que
# la contraseña de PostgreSQL se escribe una sola vez. Este archivo solo hace
# falta para cambiar algo únicamente aquí. NUNCA se sube a GitHub.

# development | test | production
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/squadfinder

# auth0 = valida el JWT de Auth0 (obligatorio en producción)
# dev   = solo para programar sin Auth0: el "token" es el usuario de prueba, por ejemplo demo|ana
AUTH_MODE=dev
AUTH0_DOMAIN=squadfinder-lfg.us.auth0.com
AUTH0_AUDIENCE=https://api.squadfinder-lfg

# Páginas que pueden conectarse al chat (lista en formato JSON)
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
